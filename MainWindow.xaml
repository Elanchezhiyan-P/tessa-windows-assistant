<Window x:Class="WinCompanion.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:WinCompanion.UI"
        Title="Tessa" Width="640" SizeToContent="Height"
        WindowStyle="None" Background="Transparent" ResizeMode="NoResize"
        ShowInTaskbar="False" Topmost="True" WindowStartupLocation="Manual"
        FontFamily="{StaticResource UiFont}" UseLayoutRounding="True">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="0" GlassFrameThickness="-1"
                      CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Border x:Name="Surface">
        <Grid x:Name="Root">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header: drag handle, current app, actions -->
            <Grid Grid.Row="0" Background="Transparent" Margin="18,8,8,0" MouseLeftButtonDown="Header_MouseDown">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="✦" Foreground="{StaticResource Accent}" FontSize="14" Margin="0,0,8,0" />
                    <TextBlock x:Name="HeaderText" Text="Tessa" Foreground="{StaticResource Fg}"
                               FontSize="13" FontWeight="SemiBold" />
                    <TextBlock x:Name="HeaderApp" Foreground="{StaticResource Muted}" FontSize="13" Margin="8,0,0,0" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="MuteButton" Style="{StaticResource IconButton}" Content="&#xE767;" ToolTip="Mute her voice" Click="Mute_Click" />
                    <Button Style="{StaticResource IconButton}" Content="&#xE710;" ToolTip="New chat" Click="NewChat_Click" />
                    <Button x:Name="ToggleButton" Style="{StaticResource IconButton}" Content="&#xE70D;"
                            ToolTip="Show or hide history" Click="Toggle_Click" />
                    <Button Style="{StaticResource IconButton}" Content="&#xE713;" ToolTip="Settings" Click="Settings_Click" />
                    <Button Style="{StaticResource IconButton}" Content="&#xE711;" ToolTip="Hide (Esc)" Click="Close_Click" />
                </StackPanel>
            </Grid>

            <!-- Chat history -->
            <ScrollViewer x:Name="Scroll" Grid.Row="1" MaxHeight="440" VerticalScrollBarVisibility="Auto" ui:SmoothScroll.Enabled="True"
                          Visibility="Collapsed">
                <StackPanel x:Name="Messages" Margin="18,6,12,8" />
            </ScrollViewer>

            <!-- Settings: three tabs of cards, with a footer that stays in view -->
            <Grid x:Name="SettingsPanel" Grid.Row="1" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="22,4,22,0">
                    <TextBlock Text="Settings" Foreground="{StaticResource Fg}" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock x:Name="SettingsNote" Foreground="#FFC27A" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0" />
                    <Border Background="{StaticResource Surface}" CornerRadius="11" Padding="3" HorizontalAlignment="Left" Margin="0,4,0,0">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="TabAi" Style="{StaticResource Segment}" Content="AI model" GroupName="tab"
                                         IsChecked="True" Checked="Tab_Changed" />
                            <RadioButton x:Name="TabYou" Style="{StaticResource Segment}" Content="You and her" GroupName="tab"
                                         Checked="Tab_Changed" />
                            <RadioButton x:Name="TabSafety" Style="{StaticResource Segment}" Content="Safety" GroupName="tab"
                                         Checked="Tab_Changed" />
                            <RadioButton x:Name="TabAbout" Style="{StaticResource Segment}" Content="About" GroupName="tab"
                                         Checked="Tab_Changed" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <ScrollViewer Grid.Row="1" MaxHeight="400" VerticalScrollBarVisibility="Auto" Margin="0,4,0,0" ui:SmoothScroll.Enabled="True">
                    <Grid Margin="22,4,22,8">

                        <!-- AI model -->
                        <StackPanel x:Name="PageAi">
                            <Border Background="{StaticResource Surface}" CornerRadius="14" Padding="16,14,16,16" Margin="0,8,0,0">
                                <StackPanel>
                                    <TextBlock Text="Which brain should she use?" Foreground="{StaticResource Fg}" FontSize="14" FontWeight="SemiBold" />
                                    <Border Background="#14FFFFFF" CornerRadius="11" Padding="3" HorizontalAlignment="Left" Margin="0,10,0,0">
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton x:Name="ProviderGemini" Style="{StaticResource Segment}"
                                                         Content="Gemini (cloud)" GroupName="provider" Checked="Provider_Changed" />
                                            <RadioButton x:Name="ProviderLocal" Style="{StaticResource Segment}"
                                                         Content="Local (Qwen)" GroupName="provider" Checked="Provider_Changed" />
                                        </StackPanel>
                                    </Border>

                                    <StackPanel x:Name="GeminiGroup">
                                        <TextBlock Text="Gemini API key" Style="{StaticResource FieldLabel}" />
                                        <PasswordBox x:Name="GeminiKeyBox" Style="{StaticResource PasswordField}" />
                                        <TextBlock x:Name="GeminiKeyState" Foreground="{StaticResource Muted}" FontSize="11.5"
                                                   TextWrapping="Wrap" Margin="2,6,0,0" />
                                        <Button x:Name="RemoveKeyButton" Style="{StaticResource GhostButton}" Content="Remove saved key"
                                                HorizontalAlignment="Left" Margin="0,8,0,0" Click="RemoveKey_Click" />
                                        <TextBlock Foreground="{StaticResource Muted}" FontSize="11.5" TextWrapping="Wrap" Margin="2,8,0,0"
                                                   Text="Free key at aistudio.google.com/apikey. Stored encrypted for your Windows account." />
                                    </StackPanel>

                                    <StackPanel x:Name="LocalGroup" Visibility="Collapsed">
                                        <TextBlock Text="Server" Style="{StaticResource FieldLabel}" />
                                        <WrapPanel Margin="0,0,0,2">
                                            <Button Style="{StaticResource Chip}" Content="Ollama" Click="PresetOllama_Click" />
                                            <Button Style="{StaticResource Chip}" Content="LM Studio" Click="PresetLmStudio_Click" />
                                            <Button Style="{StaticResource Chip}" Content="llama.cpp" Click="PresetLlamaCpp_Click" />
                                        </WrapPanel>
                                        <TextBox x:Name="LocalUrl" Style="{StaticResource Field}" />

                                        <TextBlock Text="Model" Style="{StaticResource FieldLabel}" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="LocalModel" Style="{StaticResource Field}" />
                                            <Button x:Name="DetectButton" Grid.Column="1" Style="{StaticResource GhostButton}"
                                                    Content="Detect" Margin="8,0,0,0" Click="Detect_Click" />
                                        </Grid>

                                        <TextBlock Text="Vision model for screenshots (optional)" Style="{StaticResource FieldLabel}" />
                                        <TextBox x:Name="LocalVision" Style="{StaticResource Field}" />

                                        <TextBlock x:Name="LocalStatus" Foreground="{StaticResource Muted}" FontSize="11.5"
                                                   TextWrapping="Wrap" Margin="2,8,0,0"
                                                   Text="Use a Qwen build with tool support (qwen2.5 or qwen3). Nothing leaves this PC." />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- You and her -->
                        <StackPanel x:Name="PageYou" Visibility="Collapsed">
                            <Border Background="{StaticResource Surface}" CornerRadius="14" Padding="16,14,16,16" Margin="0,8,0,0">
                                <StackPanel>
                                    <TextBlock Text="Getting to know each other" Foreground="{StaticResource Fg}" FontSize="14" FontWeight="SemiBold" />
                                    <TextBlock Text="Your name" Style="{StaticResource FieldLabel}" />
                                    <TextBox x:Name="ProfileName" Style="{StaticResource Field}" MaxLength="40" />
                                    <TextBlock Text="What she should call you" Style="{StaticResource FieldLabel}" />
                                    <TextBox x:Name="ProfileNick" Style="{StaticResource Field}" MaxLength="18" />
                                    <TextBlock Text="Her name (also her wake word, like “Hey Tessa”)" Style="{StaticResource FieldLabel}" />
                                    <TextBox x:Name="AssistantNameBox" Style="{StaticResource Field}" MaxLength="18" />
                                    <TextBlock Text="Her voice" Style="{StaticResource FieldLabel}" />
                                    <Border Background="#14FFFFFF" CornerRadius="11" Padding="3" HorizontalAlignment="Left">
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton x:Name="VoiceFemaleSeg" Style="{StaticResource Segment}" Content="Female" GroupName="voice" />
                                            <RadioButton x:Name="VoiceMaleSeg" Style="{StaticResource Segment}" Content="Male" GroupName="voice" />
                                        </StackPanel>
                                    </Border>
                                    <TextBlock Text="Language she listens in (for example en-IN or en-US; empty uses Windows' setting)" Style="{StaticResource FieldLabel}" />
                                    <TextBox x:Name="SpeechLangBox" Style="{StaticResource Field}" MaxLength="12" />
                                    <CheckBox x:Name="MuteSwitch" Style="{StaticResource Switch}" Margin="2,14,0,0"
                                              Content="Mute her voice (text replies only)" />
                                </StackPanel>
                            </Border>

                            <Border Background="{StaticResource Surface}" CornerRadius="14" Padding="16,14,16,16" Margin="0,12,0,0">
                                <StackPanel>
                                    <TextBlock Text="Who delivers your reminders" Foreground="{StaticResource Fg}" FontSize="14" FontWeight="SemiBold" />
                                    <Border Background="#14FFFFFF" CornerRadius="11" Padding="3" HorizontalAlignment="Left" Margin="0,10,0,0">
                                        <WrapPanel x:Name="PetChoices" MaxWidth="520" />
                                    </Border>
                                    <Button Style="{StaticResource GhostButton}" Content="Preview" HorizontalAlignment="Left"
                                            Margin="0,10,0,0" Click="PreviewPet_Click" />
                                    <TextBlock x:Name="PetHint" Foreground="{StaticResource Muted}" FontSize="11.5" TextWrapping="Wrap"
                                               Margin="2,6,0,0" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Safety -->
                        <StackPanel x:Name="PageSafety" Visibility="Collapsed">
                            <Border Background="{StaticResource Surface}" CornerRadius="14" Padding="16,14,16,16" Margin="0,8,0,0">
                                <StackPanel>
                                    <TextBlock Text="Privacy" Foreground="{StaticResource Fg}" FontSize="14" FontWeight="SemiBold" />
                                    <CheckBox x:Name="PrivacyAsk" Style="{StaticResource Switch}" Margin="2,12,0,0"
                                              Content="Ask before sending a screenshot, clipboard text or file to Gemini" />
                                    <TextBlock Foreground="{StaticResource Muted}" FontSize="11.5" TextWrapping="Wrap" Margin="2,10,0,0"
                                               Text="Gemini is a Google service, so what you send leaves this PC. A local model keeps everything here." />
                                </StackPanel>
                            </Border>

                            <Border Background="{StaticResource Surface}" CornerRadius="14" Padding="16,14,16,16" Margin="0,12,0,0">
                                <StackPanel>
                                    <TextBlock Text="PowerShell commands" Foreground="{StaticResource Fg}" FontSize="14" FontWeight="SemiBold" />
                                    <Border Background="#14FFFFFF" CornerRadius="11" Padding="3" HorizontalAlignment="Left" Margin="0,10,0,0">
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton x:Name="PsAsk" Style="{StaticResource Segment}"
                                                         Content="Ask unless read-only" GroupName="ps" />
                                            <RadioButton x:Name="PsTrusted" Style="{StaticResource Segment}"
                                                         Content="Run freely" GroupName="ps" />
                                        </StackPanel>
                                    </Border>
                                    <TextBlock Foreground="{StaticResource Muted}" FontSize="11.5" TextWrapping="Wrap" Margin="2,10,0,0"
                                               Text="Run freely lets her run the commands she writes without asking, except dangerous ones (delete, overwrite, install, download-and-run, registry, shutdown), which still need your approval. Small local models make mistakes, so start with the default." />
                                    <CheckBox x:Name="PsAdmin" Style="{StaticResource Switch}" Margin="2,14,0,0"
                                              Content="Allow administrator commands (Windows asks you each time)" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- About -->
                        <StackPanel x:Name="PageAbout" Visibility="Collapsed">
                            <Border Background="{StaticResource Surface}" CornerRadius="14" Padding="16,14,16,16" Margin="0,8,0,0">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="✦" Foreground="{StaticResource Accent}" FontSize="20" Margin="0,0,8,0" />
                                        <TextBlock x:Name="AboutName" Text="Tessa" Foreground="{StaticResource Fg}" FontSize="20" FontWeight="SemiBold" />
                                    </StackPanel>
                                    <TextBlock x:Name="AboutVersion" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,4,0,0" />
                                    <TextBlock Foreground="{StaticResource Muted}" FontSize="12.5" TextWrapping="Wrap" Margin="0,10,0,0"
                                               Text="A free, open-source AI companion for Windows. Works with Gemini or a local model." />

                                    <TextBlock Text="Made by" Style="{StaticResource FieldLabel}" Margin="2,16,0,2" />
                                    <TextBlock Text="Elanchezhiyan P" Foreground="{StaticResource Fg}" FontSize="14" FontWeight="SemiBold" />

                                    <WrapPanel Margin="0,12,0,0">
                                        <Button Style="{StaticResource GhostButton}" Content="codebyelan.in" Margin="0,0,8,8"
                                                Tag="https://codebyelan.in" Click="AboutLink_Click" />
                                        <Button Style="{StaticResource GhostButton}" Content="Email" Margin="0,0,8,8"
                                                Tag="mailto:elanche97@gmail.com" Click="AboutLink_Click" />
                                        <Button Style="{StaticResource GhostButton}" Content="GitHub" Margin="0,0,8,8"
                                                Tag="https://github.com/Elanchezhiyan-P/tessa-windows-assistant" Click="AboutLink_Click" />
                                        <Button Style="{StaticResource GhostButton}" Content="Report a problem" Margin="0,0,8,8"
                                                Tag="https://github.com/Elanchezhiyan-P/tessa-windows-assistant/issues" Click="AboutLink_Click" />
                                    </WrapPanel>
                                    <TextBlock Foreground="{StaticResource Muted}" FontSize="11.5" TextWrapping="Wrap" Margin="2,4,0,0"
                                               Text="MIT licence. Copyright (c) 2026 Elanchezhiyan P. Character credits are in Assets\Pets\CREDITS.md." />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>

                <Grid Grid.Row="2" Margin="22,8,22,12">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource GhostButton}" Content="Cancel" Click="CancelSettings_Click" />
                        <Button Style="{StaticResource PrimaryButton}" Content="Save" Margin="8,0,0,0" Click="SaveSettings_Click" />
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- Suggestions for the current app -->
            <WrapPanel x:Name="Chips" Grid.Row="2" Margin="18,2,18,0" />

            <!-- Approval card for risky actions -->
            <Border x:Name="ConfirmCard" Grid.Row="3" Margin="14,4,14,4" Padding="14,12" CornerRadius="12"
                    Background="#33FFB454" BorderBrush="#66FFB454" BorderThickness="1" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="Allow this action?" Foreground="{StaticResource Fg}" FontWeight="SemiBold" FontSize="13" />
                    <TextBlock x:Name="ConfirmText" Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap"
                               FontFamily="Cascadia Mono, Consolas" Margin="0,6,0,10" MaxHeight="110" />
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource PrimaryButton}" Content="Allow" Click="Allow_Click" />
                        <Button Style="{StaticResource GhostButton}" Content="Deny" Margin="8,0,0,0" Click="Deny_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Input -->
            <Border Grid.Row="4" Margin="14,4,14,4" CornerRadius="14" Background="{StaticResource Surface}"
                    BorderBrush="{StaticResource Stroke}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Grid>
                        <TextBlock x:Name="Placeholder" Text="Ask anything…   (Ctrl+Alt+V to talk)"
                                   Foreground="{StaticResource Muted}" FontSize="15" Margin="16,0,0,0"
                                   VerticalAlignment="Center" IsHitTestVisible="False" />
                        <TextBox x:Name="Input" Background="Transparent" BorderThickness="0"
                                 Foreground="{StaticResource Fg}" CaretBrush="White" FontSize="15"
                                 SelectionBrush="{StaticResource Accent}"
                                 Padding="14,12" VerticalContentAlignment="Center"
                                 KeyDown="Input_KeyDown" TextChanged="Input_TextChanged" />
                    </Grid>
                    <Button x:Name="MicButton" Grid.Column="1" Style="{StaticResource IconButton}" Content="&#xE720;"
                            ToolTip="Talk (Ctrl+Alt+V)" Click="Mic_Click" />
                    <Button x:Name="SendButton" Grid.Column="2" Style="{StaticResource IconButton}" Content="&#xE724;"
                            ToolTip="Send" Margin="0,0,5,0" Click="Send_Click" />
                </Grid>
            </Border>

            <Grid Grid.Row="5" Margin="20,0,18,10">
                <TextBlock x:Name="Status" MinHeight="14" Foreground="{StaticResource Muted}" FontSize="11" />
                <TextBlock x:Name="ModelLabel" HorizontalAlignment="Right" Foreground="{StaticResource Muted}"
                           FontSize="11" />
            </Grid>
        </Grid>
    </Border>
</Window>
