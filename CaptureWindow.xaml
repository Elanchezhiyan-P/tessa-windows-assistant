<Window x:Class="WinCompanion.CaptureWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quick capture" Width="460" SizeToContent="Height"
        WindowStyle="None" Background="Transparent" ResizeMode="NoResize"
        ShowInTaskbar="False" Topmost="True" WindowStartupLocation="Manual"
        FontFamily="{StaticResource UiFont}" UseLayoutRounding="True">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="0" GlassFrameThickness="-1"
                      CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Border x:Name="Surface" Padding="16,14,16,12">
        <StackPanel>
            <TextBlock Text="Quick capture" Foreground="{StaticResource Fg}" FontSize="13" FontWeight="SemiBold" />
            <TextBlock Text="Type a note. Start with “todo:” to save it as a task. Enter saves, Esc cancels."
                       Foreground="{StaticResource Muted}" FontSize="11" Margin="0,2,0,8" TextWrapping="Wrap" />
            <TextBox x:Name="Box" Style="{StaticResource Field}" AcceptsReturn="False" MaxLength="500"
                     AutomationProperties.Name="Note" KeyDown="Box_KeyDown" />
            <TextBlock x:Name="Result" MinHeight="14" Foreground="{StaticResource Muted}" FontSize="11" Margin="2,8,0,0" />
        </StackPanel>
    </Border>
</Window>
