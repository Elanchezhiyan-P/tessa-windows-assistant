<Window x:Class="WinCompanion.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Welcome" Width="460" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" Topmost="True" Background="#FF1E1F26"
        FontFamily="{StaticResource UiFont}" UseLayoutRounding="True">
    <StackPanel Margin="30,26,30,26">
        <TextBlock Foreground="{StaticResource Accent}" FontSize="22" Text="✦" />
        <TextBlock Foreground="{StaticResource Fg}" FontSize="21" FontWeight="SemiBold" Margin="0,6,0,0"
                   Text="Let's get to know each other" />
        <TextBlock Foreground="{StaticResource Muted}" FontSize="12.5" TextWrapping="Wrap" Margin="0,6,0,14"
                   Text="Tell me how to address you and what to call me. You can change all of this later in Settings." />

        <TextBlock Style="{StaticResource FieldLabel}" Text="Your name" />
        <TextBox x:Name="UserNameBox" Style="{StaticResource Field}" MaxLength="40" />

        <TextBlock Style="{StaticResource FieldLabel}" Text="What should I call you? (a short name)" />
        <TextBox x:Name="NickBox" Style="{StaticResource Field}" MaxLength="18" />

        <TextBlock Style="{StaticResource FieldLabel}" Text="My name" />
        <TextBox x:Name="AssistantBox" Style="{StaticResource Field}" MaxLength="18" />
        <TextBlock x:Name="WakeHint" Foreground="{StaticResource Muted}" FontSize="11.5" Margin="2,6,0,0" />

        <TextBlock Style="{StaticResource FieldLabel}" Text="My voice" />
        <Border Background="{StaticResource Surface}" CornerRadius="11" Padding="3" HorizontalAlignment="Left">
            <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="VoiceFemale" Style="{StaticResource Segment}" Content="Female" GroupName="v" />
                <RadioButton x:Name="VoiceMale" Style="{StaticResource Segment}" Content="Male" GroupName="v" />
            </StackPanel>
        </Border>

        <StackPanel Orientation="Horizontal" Margin="0,24,0,0">
            <Button Style="{StaticResource PrimaryButton}" Content="Start" IsDefault="True" Click="Start_Click" />
            <Button Style="{StaticResource GhostButton}" Content="Skip for now" Margin="8,0,0,0" Click="Skip_Click" />
        </StackPanel>
    </StackPanel>
</Window>
